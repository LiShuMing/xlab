global:
  scrape_interval: 2s
  scrape_timeout: 1s
  evaluation_interval: 5s

scrape_configs:
  - job_name: vllm
    metrics_path: /metrics
    static_configs:
      - targets: ["${MODEL_TARGET}"]
  - job_name: macos
    static_configs:
      - targets: ["127.0.0.1:${EXPORTER_PORT}"]
  - job_name: prometheus
    scrape_interval: 5s
    static_configs:
      - targets: ["127.0.0.1:${PROMETHEUS_PORT}"]
  - job_name: jaeger
    scrape_interval: 5s
    static_configs:
      - targets: ["127.0.0.1:${JAEGER_METRICS_PORT}"]
