service:
  extensions: [jaeger_storage, jaeger_query]
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, batch]
      exporters: [jaeger_storage_exporter]
  telemetry:
    resource:
      service.name: jaeger-local
    metrics:
      level: normal
      readers:
        - pull:
            exporter:
              prometheus:
                host: 127.0.0.1
                port: ${JAEGER_METRICS_PORT}
    logs:
      level: info

extensions:
  jaeger_storage:
    backends:
      local_memory:
        memory:
          max_traces: 1000
  jaeger_query:
    storage:
      traces: local_memory
    http:
      endpoint: "127.0.0.1:${JAEGER_UI_PORT}"
    grpc:
      endpoint: "127.0.0.1:${JAEGER_QUERY_PORT}"
    max_clock_skew_adjust: 0s

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: "127.0.0.1:${OTLP_GRPC_PORT}"
      http:
        endpoint: "127.0.0.1:${OTLP_HTTP_PORT}"

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 256
    spike_limit_mib: 64
  batch:
    timeout: 1s
    send_batch_size: 128
    send_batch_max_size: 256

exporters:
  jaeger_storage_exporter:
    trace_storage: local_memory
