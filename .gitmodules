# Submodule policy:
# - Keep heavy research dependencies optional; initialize only the module you need.
# - Prefer targeted commands such as:
#     git submodule update --init cc/thirdparty/googletest cc/thirdparty/benchmark
# - Avoid default recursive initialization unless you explicitly need all third-party code.
#
# Categories:
# - Core C++ build/test dependencies: small or commonly required by cc/cclab.
# - C language references: compiler/interpreter study material.
# - C++ systems/database research: large optional source references.
# - Rust systems/database research: large optional source references.
# - Python references: optional source references.

# Core C++ build/test dependencies.
[submodule "cc/thirdparty/benchmark"]
	path = cc/thirdparty/benchmark
	url = https://github.com/google/benchmark.git
[submodule "cc/thirdparty/glog"]
	path = cc/thirdparty/glog
	url = git@github.com:google/glog.git
[submodule "cc/thirdparty/googletest"]
	path = cc/thirdparty/googletest
	url = https://github.com/google/googletest.git
[submodule "cc/thirdparty/abseil-cpp"]
	path = cc/thirdparty/abseil-cpp
	url = git@github.com:abseil/abseil-cpp.git

# C language references.
[submodule "c/minilisp"]
	path = c/minilisp
	url = git@github.com:rui314/minilisp.git
[submodule "c/chibicc"]
	path = c/chibicc
	url = git@github.com:rui314/chibicc.git

