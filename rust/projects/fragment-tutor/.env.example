# FragmentTutor Environment Variables
# Copy this file to .env and fill in your values

# OpenAI-compatible LLM configuration
# The app also reads these defaults from ~/.env.
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name
LLM_TIMEOUT=120

# Legacy fallback supported by the backend when LLM_API_KEY is absent.
# ANTHROPIC_API_KEY=your-api-key-here

# Database (SQLite - no config needed for local file)
# DATABASE_URL=sqlite:fragment_tutor.db

# Optional PostgreSQL metadata/sync target for future server-side workflows.
# FragmentTutor still uses local SQLite for the primary desktop store.
PSQL_URL=localhost
PSQL_PORT=5432
PSQL_USER=fragment_tutor
PSQL_PASSWORD=change-me
PSQL_DEFAULT_DB=fragment_tutor

# Optional: Custom storage path
# STORAGE_PATH=./data
