{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "地铁小向导",
  "version": "1.0.0",
  "identifier": "com.xlab.subwayguide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "地铁小向导",
        "width": 1100,
        "height": 800,
        "minWidth": 900,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
